server {
    listen 80;
    server_name localhost;

    root /var/www/kiwix-skin;

    location = / {
        try_files /index.html =404;
    }

    location = /skin/index.css {
        rewrite ^ /index.css break;
    }

    location = /skin/kiwix.css {
        rewrite ^ /kiwix.css break;
    }

    location = /skin/Vazirmatn-Medium.ttf {
        rewrite ^ /Vazirmatn-Medium.ttf break;
    }

    location / {
        try_files $uri @kiwix_backend;
    }

    location @kiwix_backend {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}